# Copy to .env and fill in. Never commit .env.

# Supabase → Connect → "Transaction pooler" connection string (port 6543), with your DB password
DATABASE_URL=postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Frontend URLs allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Password given to every demo account by seed.py
DEMO_PASSWORD=SiamBean2026!
